<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>iGCRGB</AssemblyName>
    <RootNamespace>iGCRGB</RootNamespace>
    <Version>2.0.0</Version>
    <Company>iGCRGB contributors</Company>
    <Product>iGCRGB 主板灯光控制</Product>
    <AssemblyTitle>iGCRGB 主板灯光控制</AssemblyTitle>
    <Description>七彩虹 iGame 主板灯光独立控制面板</Description>
    <Nullable>disable</Nullable>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      七彩虹的 iGC 闭源组件不随仓库分发。
      请先安装 iGC.Lite，再运行 scripts/prepare-vendor-libs.ps1 把所需 DLL 复制到仓库根目录的 vendor/。
      也可以通过命令行覆盖：dotnet build -p:VendorDir="D:\path\to\vendor\"
    -->
    <VendorDir Condition="'$(VendorDir)' == ''">$(MSBuildProjectDirectory)\..\..\vendor\</VendorDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="iGameAPI.Contracts">
      <HintPath>$(VendorDir)iGameAPI.Contracts.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Configuration" />
  </ItemGroup>

  <!-- 缺少厂商组件时给出明确提示，而不是晦涩的 CS0246 -->
  <Target Name="CheckVendorLibs" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(VendorDir)iGameAPI.Contracts.dll')"
           Text="缺少七彩虹的 iGameAPI.Contracts.dll。请先安装 iGC.Lite，然后在仓库根目录运行：pwsh scripts/prepare-vendor-libs.ps1 -IgcPath &quot;你的 iGC 安装目录&quot;" />
  </Target>

</Project>
